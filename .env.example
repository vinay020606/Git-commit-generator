# Your OpenAI API Key (or OpenAI-compatible API key)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: AI model to use (default: gpt-4o-mini, or gpt-5-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: Custom OpenAI-compatible base URL (e.g. for Ollama, Groq, OpenRouter, DeepSeek)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Max lines of staged diff sent to LLM (default: 200)
# GIT_COMMIT_GENERATOR_MAX_LINES=200

# Optional: Request timeout in milliseconds (default: 8000)
# GIT_COMMIT_GENERATOR_TIMEOUT=8000
